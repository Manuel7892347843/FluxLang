void print_bool(int b){
    if(b != 0){
        print("true");
    }
    else{
        print("false");
    }
}

void print_char(char c){
    print(c);
}

void print_int(int n){
    print(n);
}

void println_str(*char s){
    print(s);
    println();
}

void println_bool(bool b, bool format){
    if(format){
        print_bool(b);
    }
    else{
        print(b);
    }
    println();
}

void println_int(int n) {
    print(n);
    println();
}

void println_char(char c) {
    print(c);
    println();
}

void print_space() {
    print(" ");
}

void println(){
    print("\n");
}