void print_bool(int b){
    if(b != 0){
        print("true");
    }
    else{
        print("false");
    }
}

void print_char(char c){
    print(c);
}

void print_int(int n){
    print(n);
}

void println(*char s){
    print(s);
    print("\n");
}

void println_int(int n) {
    print(n);
    print("\n");
}

void println_char(char c) {
    print(c);
    print("\n");
}

void print_space() {
    print(" ");
}

void print_bool_str(int b) {
    if (b != 0) {
        print("true");
    } else {
        print("false");
    }
}